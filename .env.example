# ===== 融合工作台 · 环境变量模板 =====
# 使用方法：复制本文件为 .env 并填入真实值。
# 注意：.env 已在 .gitignore 中，不会被提交，可安全存放 Key。

# ---- LLM（OpenAI 兼容接口）----
# 不配置 LLM_API_KEY 时，全系统自动降级为「规则 / 演示模式」：
# 合同走规则引擎审查、客服走关键词路由、智库走 FAQ 兜底，功能不残缺。
LLM_API_KEY=
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
LLM_TIMEOUT=60

# ---- 服务 ----
APP_HOST=0.0.0.0
APP_PORT=8020
